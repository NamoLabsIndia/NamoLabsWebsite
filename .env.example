# Copy to `.env.local` for development, or set these in the hosting provider's
# environment settings for production. Never commit real values.

# Resend API key. Required by /api/contact and /api/careers/apply — without it
# both routes return a server error and no mail is sent.
RESEND_API_KEY=

# Verified sender on the namolabs.in domain, in "Name <address>" form.
# Falls back to Resend's shared onboarding sender, which only delivers to the
# Resend account owner's own address.
CONTACT_FROM_EMAIL="Namo Labs <careers@namolabs.in>"

# Where contact form submissions are delivered. Defaults to info@namolabs.in.
CONTACT_TO_EMAIL=info@namolabs.in

# Optional. Where career applications are delivered. Falls back to
# CONTACT_TO_EMAIL when unset.
CAREERS_TO_EMAIL=careers@namolabs.in

# ── Cloudflare R2 (for storing resumes) ───────────────────────────────────
# You can get these from the Cloudflare dashboard under R2 > Manage API Tokens
CF_R2_ACCOUNT_ID=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_KEY=
CF_R2_BUCKET=namolabscareers
CF_R2_PUBLIC_URL= # e.g. https://resumes.namolabs.in (optional)

# ── Supabase (for storing structured application data) ────────────────────
# You can get these from the Supabase dashboard under Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
